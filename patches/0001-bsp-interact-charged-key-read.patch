+/* The pads have no usable internal pull-up: once a key-to-GND press
+ * discharges a pad, a plain input read reports "pressed" for minutes.
+ * Emulate the pull-up: charge the pad through the output driver, then
+ * sample it as a floating input. A held key keeps the pad low against the
+ * brief drive; a released key keeps its charge until the next refresh.
+ * When the first sample reads low, retry once with a longer charge so a
+ * marginal charge cannot latch a released key. */
+static bool read_gpio_key_charged(int io)
+{
+    gpio_config_t charge = {
+        .pin_bit_mask = BIT64(io),
+        .mode = GPIO_MODE_OUTPUT,
+        .pull_up_en = GPIO_PULLUP_DISABLE,
+        .pull_down_en = GPIO_PULLDOWN_DISABLE,
+        .intr_type = GPIO_INTR_DISABLE,
+    };
+    gpio_config_t sample = {
+        .pin_bit_mask = BIT64(io),
+        .mode = GPIO_MODE_INPUT,
+        .pull_up_en = GPIO_PULLUP_DISABLE,
+        .pull_down_en = GPIO_PULLDOWN_DISABLE,
+        .intr_type = GPIO_INTR_DISABLE,
+    };
+    (void)gpio_config(&charge);
+    (void)gpio_set_level(io, 1);
+    esp_rom_delay_us(50);
+    (void)gpio_config(&sample);
+    if (gpio_get_level(io) != 0) {
+        return false;
+    }
+    (void)gpio_config(&charge);
+    (void)gpio_set_level(io, 1);
+    esp_rom_delay_us(500);
+    (void)gpio_config(&sample);
+    return gpio_get_level(io) == 0;
+}
